# Environment & Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/app/cache/*.db
backend/app/cache/*.db-journal
backend/data/imerg/raw/
backend/data/imerg/processed/

# New signal snapshots are persisted to the data branch, not committed daily.
# One verified baseline snapshot per source ships with the app so a fresh
# deployment resolves every field signal without a download step.
backend/data/signals/*
!backend/data/signals/baselines.json
!backend/data/signals/lst/
!backend/data/signals/smap/
!backend/data/signals/vegetation/
backend/data/signals/lst/*
!backend/data/signals/lst/2026-11-02.json
backend/data/signals/smap/*
!backend/data/signals/smap/2026-11-12.json
backend/data/signals/vegetation/*
!backend/data/signals/vegetation/2026-11-08.json

# Automatic refresh status and lock are runtime state, not source code.
backend/data/automation-status.json
backend/data/automation-status.json.lock

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.venv/
venv/

# Frontend build-time generated assets (regenerated by predev/prebuild scripts)
frontend/public/data/
frontend/public/maplibre/
frontend/bun.lock

# Verified raw snapshots staged before publish
backend/data/incoming/
