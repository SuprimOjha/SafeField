# Environment & Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/app/cache/*.db
backend/app/cache/*.db-journal
backend/data/imerg/raw/
backend/data/imerg/processed/

# Generated signal snapshots and status.json are persisted to the data branch,
# never committed as application code.
backend/data/signals/
backend/data/status.json

# Automatic refresh status and lock are runtime state, not source code.
backend/data/automation-status.json
backend/data/automation-status.json.lock

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.venv/
venv/

# Frontend build-time generated assets (regenerated by predev/prebuild scripts)
frontend/public/data/
frontend/public/maplibre/
frontend/bun.lock

# Verified raw snapshots staged before publish
backend/data/incoming/
