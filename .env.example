# Backend Configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache & HTTP Settings
CACHE_DB_PATH=app/cache/safefield_cache.db
HTTP_TIMEOUT_SECONDS=12.0

# NASA Earthdata credentials are read from the environment or backend/.env.
# Put them in backend/.env for the automatic refresh:
#   EARTHDATA_USERNAME=...
#   EARTHDATA_PASSWORD=...
#   # or a single token:
#   EARTHDATA_TOKEN=...
# `python -m app.cli fetch-imerg` prompts securely when they are missing.
# Never commit credentials or put them in Git.

# Automatic data install and retention
DATA_REFRESH_ENABLED=true
DATA_REFRESH_INTERVAL_HOURS=6
DATA_REFRESH_STARTUP_DELAY_SECONDS=60
IMERG_REFRESH_DAYS=3
IMERG_RETENTION_DAYS=30
API_CACHE_RETENTION_DAYS=30
SIGNAL_RETENTION_DAYS=120

# Supabase storage (optional). Leave these empty to keep using local SQLite
# and the local data directories. Never commit the secret key.
# SUPABASE_DB_URL is the Postgres connection string (Project Settings ->
# Database -> Connection string). It stores the API cache and IMERG grid cells.
# SUPABASE_URL and SUPABASE_SECRET_KEY mirror snapshot/raw files to
# Supabase Storage. SUPABASE_SERVICE_ROLE_KEY is the legacy alternative.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=safefield-data
SUPABASE_RESTORE_ON_STARTUP=true
# Supabase Storage is a live cache, not the archive: only files newer than this
# many days are uploaded, and older remote objects are deleted. The long
# timeline is published to the git `data` branch by data-publish.yml.
SUPABASE_RECENT_DAYS=3

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
