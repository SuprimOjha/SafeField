# Backend Configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache & HTTP Settings
CACHE_DB_PATH=app/cache/safefield_cache.db
HTTP_TIMEOUT_SECONDS=12.0

# NASA Earthdata credentials are read from the environment or backend/.env.
# Put them in backend/.env for the automatic refresh:
#   EARTHDATA_USERNAME=...
#   EARTHDATA_PASSWORD=...
# `python -m app.cli fetch-imerg` prompts securely when they are missing.
# Never commit credentials or put them in Git.

# Automatic data install and retention
DATA_REFRESH_ENABLED=true
DATA_REFRESH_INTERVAL_HOURS=6
DATA_REFRESH_STARTUP_DELAY_SECONDS=60
IMERG_REFRESH_DAYS=3
IMERG_RETENTION_DAYS=30
API_CACHE_RETENTION_DAYS=30
SIGNAL_RETENTION_DAYS=120

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
