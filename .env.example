# Backend Configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache & HTTP Settings
CACHE_DB_PATH=app/cache/safefield_cache.db
HTTP_TIMEOUT_SECONDS=12.0

# NASA Earthdata credentials are prompted securely in the terminal when
# running: python -m app.cli fetch-imerg
# For unattended jobs only, set EARTHDATA_USERNAME and EARTHDATA_PASSWORD
# as environment variables. Never commit credentials or put them in Git.

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
