# Backend environment for Safe Field Nepal.
# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored; never commit real credentials.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NASA Earthdata Login credentials.
# The automatic IMERG refresh uses these to download newly published daily
# granules. Leave them empty to run the app without new satellite installs.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Optional: use a token instead of username/password.
EARTHDATA_TOKEN=

# Automatic data refresh and retention.
DATA_REFRESH_ENABLED=true
DATA_REFRESH_INTERVAL_HOURS=6
DATA_REFRESH_STARTUP_DELAY_SECONDS=60
# How many recent completed UTC days are checked for newly published data.
IMERG_REFRESH_DAYS=3
# Delete IMERG cells and raw granules older than this many days.
IMERG_RETENTION_DAYS=30
# Delete cached live API responses older than this many days.
API_CACHE_RETENTION_DAYS=30
# Delete installed satellite snapshots and staged raw files older than this.
SIGNAL_RETENTION_DAYS=120

# Cache and HTTP settings (defaults shown).
# CACHE_DB_PATH=app/cache/safefield_cache.db
HTTP_TIMEOUT_SECONDS=12.0
